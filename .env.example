# Copy this file to .env and paste your key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here

# Model to use (any id from https://openrouter.ai/models — free ones end with :free)
OPENROUTER_MODEL=minimax/minimax-m2.7:free

# Optional Google sign-in. Leave blank to run without login.
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > "Desktop app".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional backend (server/app.py). When set, the OpenRouter key is NOT needed on this machine.
CONSIZ_SERVER_URL=
